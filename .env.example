# Server-side only — never expose to the client.
ANTHROPIC_API_KEY=

# Shared secret the client sends as a Bearer token. Pick anything long and random.
PROXY_AUTH_TOKEN=

# Optional: override the default model.
CLAUDE_MODEL=claude-sonnet-4-20250514

# Client-facing (Vite only exposes VITE_-prefixed vars to the browser).
# This is the SAME value as PROXY_AUTH_TOKEN. Kept separate so server secrets and
# browser-visible tokens are explicit.
VITE_PROXY_AUTH_TOKEN=
